# nginx site config for the url-shortener: reverse proxy to the Spring app on
# :9000, with an edge cache for the (immutable) /expand redirects.
#
# Deploy (Ubuntu):
#   sudo cp nginx/url-shortener /etc/nginx/sites-available/url-shortener
#   sudo ln -sf /etc/nginx/sites-available/url-shortener /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo mkdir -p /var/cache/nginx/expand
#   sudo chown -R www-data:www-data /var/cache/nginx
#   sudo nginx -t && sudo systemctl reload nginx
#
# TLS certs are already at /etc/letsencrypt/live/zill.ninja/ (issued by Certbot).
# Renewals stay on Certbot's timer; this file only points nginx at those files.
# Open security-group inbound 80 and 443.

# --- http {} block ---
proxy_cache_path /var/cache/nginx/expand levels=1:2 keys_zone=expand:50m
                 max_size=500m inactive=24h use_temp_path=off;

# Collapse high-cardinality paths into stable route labels.
map $uri $route {
    ~^/expand/   "/expand/{id}";
    ~^/fault/    "/fault/{code}";
    default      $uri;
}

# Space-free key=value pairs for Loki's | logfmt parser.
log_format edge 'ts=$time_iso8601 status=$status method=$request_method '
                'route=$route cache=$upstream_cache_status '
                'rt=$request_time urt=$upstream_response_time';

upstream app {
    server 127.0.0.1:9000;
    keepalive 64;
}

server {
    listen 80;
    server_name zill.ninja www.zill.ninja;

    # Let Certbot renew over HTTP-01 before the HTTPS redirect.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name zill.ninja www.zill.ninja;

    ssl_certificate     /etc/letsencrypt/live/zill.ninja/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zill.ninja/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/access.log edge;

    # Cache immutable redirect lookups.
    location /expand/ {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_cache expand;
        proxy_cache_key "$uri";
        proxy_cache_valid 302 24h;
        proxy_cache_valid 404 10s;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # All other requests, including writes, are not cached.
    location / {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}