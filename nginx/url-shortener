# URL shortener: Nginx reverse proxy to Spring Boot on port 9000.
# HTTPS terminates at the Hetzner Load Balancer, which forwards to this
# server over HTTP on port 80.
#
# Deploy:
#   sudo mkdir -p /var/cache/nginx/expand
#   sudo chown -R www-data:www-data /var/cache/nginx
#   sudo ln -sfn /etc/nginx/sites-available/url-shortener /etc/nginx/sites-enabled/url-shortener
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx

proxy_cache_path /var/cache/nginx/expand levels=1:2 keys_zone=expand:50m
                 max_size=500m inactive=24h use_temp_path=off;

# Collapse high-cardinality paths into stable route labels.
map $uri $route {
    ~^/expand/   "/expand/{id}";
    ~^/fault/    "/fault/{code}";
    default      $uri;
}

# Space-free key=value pairs for Loki's logfmt parser.
log_format edge 'ts=$time_iso8601 status=$status method=$request_method '
                'route=$route cache=$upstream_cache_status '
                'rt=$request_time urt=$upstream_response_time';

upstream app {
    server 127.0.0.1:9000;
    keepalive 64;
}

server {
    listen 80;
    server_name _;

    access_log /var/log/nginx/access.log edge;

    # Cache immutable redirect lookups.
    location /expand/ {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_cache expand;
        proxy_cache_key "$uri";
        proxy_cache_valid 302 24h;
        proxy_cache_valid 404 10s;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # All other requests, including writes, are never cached.
    location / {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
