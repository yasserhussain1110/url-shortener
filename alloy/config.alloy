// -----------------------------
// Remote config (Fleet Management)
// -----------------------------
// remotecfg {
//   url            = "https://fleet-management-prod-018.grafana.net"
//   id             = "ip-172-31-16-196"
//   poll_frequency = "60s"
//   attributes     = encoding.from_json(coalesce(``, `{}`))
//
//   basic_auth {
//     username = "1403143"
//     password = sys.env("GCLOUD_RW_API_KEY")
//   }
// }

// -----------------------------
// Send metrics → Grafana Cloud
// -----------------------------
prometheus.remote_write "metrics_service" {
  endpoint {
    url = "https://prometheus-prod-43-prod-ap-south-1.grafana.net/api/prom/push"

    basic_auth {
      username = "2730521"
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// -----------------------------
// Send logs → Grafana Cloud (Loki)
// -----------------------------
loki.write "grafana_cloud_loki" {
  endpoint {
    url = "https://logs-prod-028.grafana.net/loki/api/v1/push"

    basic_auth {
      username = "1360937"
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// -----------------------------
// Spring Boot Actuator Metrics
// Scraped via nginx on :80, which proxies /actuator/prometheus straight through
// to the app on :9000 (that path is uncached, so metrics are live). These are
// still the app's own Micrometer counters — the :80 in the label is just where
// we fetch them, not nginx's own throughput.
// -----------------------------
prometheus.scrape "url_shortener" {
  targets = [
    {
      __address__ = "localhost:80",
      application = "url-shortener",
      instance    = "localhost:80",
    },
  ]

  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.metrics_service.receiver,
  ]
}

// -----------------------------
// Linux Host Metrics
// (Built-in Node Exporter)
// -----------------------------
prometheus.exporter.unix "node" {
}

prometheus.scrape "node_exporter" {
  targets = prometheus.exporter.unix.node.targets

  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.metrics_service.receiver,
  ]
}

prometheus.scrape "mysql" {
  targets = [
    {
      __address__ = "localhost:9104",
      application = "mysql",
      instance = "localhost",
    },
  ]

  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.metrics_service.receiver,
  ]
}

// -----------------------------
// nginx access log → Loki
// Ships the edge access log (logfmt: route + upstream_cache_status) so LogQL can
// chart true edge RPS split by cache HIT/MISS and by route — the read volume the
// app's http_server_requests can't see, because cache hits never reach the app.
// route/cache stay in the line (parsed at query time via `| logfmt`) instead of
// as labels, to keep Loki stream cardinality low.
// -----------------------------
local.file_match "nginx" {
  path_targets = [{
    __path__ = "/var/log/nginx/access.log",
    job      = "nginx",
    instance = constants.hostname,
  }]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.write.grafana_cloud_loki.receiver]
}
